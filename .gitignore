# Dependencies and secrets
node_modules/
.env
.env.*
!.env.example

# Rendered / scratch media (regenerated by the commands in CLAUDE.md)
out/
episodes/*/out/*.mp4
episodes/*/qa/*.jpg
episodes/*/qa/*.png
