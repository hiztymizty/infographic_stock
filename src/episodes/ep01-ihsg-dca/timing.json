 "voice": [
  {
   "id": "take-hook-1",
   "scene": "hook",
   "from": 10,
   "dur": 181,
   "audio": "episodes/ep01-ihsg-dca/vo/take-hook-1.mp3",
   "display": "Kalau dari 2010, kamu nabung saham Rp 5 juta tiap bulan, sekarang jadi berapa?",
   "spoken": "Kalau dari dua ribu sepuluh, kamu nabung saham lima juta rupiah tiap bulan, sekarang jadi berapa?"
  },
  {
   "id": "take-rules-1",
   "scene": "rules",
   "from": 216,
   "dur": 409,
   "audio": "episodes/ep01-ihsg-dca/vo/take-rules-1.mp3",
   "display": "Ini namanya DCA, singkatan dari Dollar Cost Averaging, artinya beli rutin dengan jumlah yang sama. Satu lagi, nggak pernah jual. Total modal kamu jadi Rp 1 miliar lebih.",
   "spoken": "Ini namanya DCA, singkatan dari Dollar Cost Averaging, artinya beli rutin dengan jumlah yang sama. Satu lagi, nggak pernah jual. Total modal kamu jadi satu miliar lebih."
  },
  {
   "id": "take-ihsg-1",
   "scene": "ihsg",
   "from": 649,
   "dur": 284,
   "audio": "episodes/ep01-ihsg-dca/vo/take-ihsg-1.mp3",
   "display": "IHSG, indeks saham Indonesia, mulai dari 2.600-an. Lalu naik tiga kali lipat lebih, sampai 8.600.",
   "spoken": "I-Ha-Es-Ge, indeks saham Indonesia, mulai dari dua ribu enam ratusan. Lalu naik tiga kali lipat lebih, sampai delapan ribu enam ratus."
  },
  {
   "id": "take-ihsg-2",
   "scene": "ihsg",
   "from": 954,
   "dur": 78,
   "audio": "episodes/ep01-ihsg-dca/vo/take-ihsg-2.mp3",
   "display": "Terus… 2026 datang.",
   "spoken": "Terus… dua ribu dua puluh enam datang."
  },
  {
   "id": "take-journey-1",
   "scene": "journey",
   "from": 1056,
   "dur": 745,
   "audio": "episodes/ep01-ihsg-dca/vo/take-journey-1.mp3",
   "display": "Garis biru itu modal kamu, dan selama hijau di atasnya, kamu untung. Tahun 2015, untungmu tinggal tipis. Tapi kamu tetap beli. Maret 2020, COVID datang dan kamu sempat rugi. Kamu nggak jual, dan nilainya tembus Rp 1 miliar. Habis itu naik pelan-pelan. Di puncaknya, kamu untung 67%!",
   "spoken": "Garis biru itu modal kamu, dan selama hijau di atasnya, kamu untung. Tahun dua ribu lima belas, untungmu tinggal tipis. Tapi kamu tetap beli. Maret dua ribu dua puluh, COVID datang dan kamu sempat rugi. Kamu nggak jual, dan nilainya tembus satu miliar. Habis itu naik pelan-pelan. Di puncaknya, kamu untung enam puluh tujuh persen!"
  },
  {
   "id": "take-twist-1",
   "scene": "twist",
   "from": 1901,
   "dur": 253,
   "audio": "episodes/ep01-ihsg-dca/vo/take-twist-1.mp3",
   "display": "Uangmu yang tadinya Rp 1,6 miliar, Juni tinggal Rp 1 miliar lebih dikit. Lebih dari setengah miliar hilang, cuma dalam enam bulan.",
   "spoken": "Uangmu yang tadinya satu koma enam miliar, Juni tinggal satu miliar lebih dikit. Lebih dari setengah miliar hilang, cuma dalam enam bulan."
  },
  {
   "id": "take-result-1",
   "scene": "result",
   "from": 2179,
   "dur": 273,
   "audio": "episodes/ep01-ihsg-dca/vo/take-result-1.mp3",
   "display": "Hari ini, modal Rp 1 miliar jadi hampir Rp 1,2 miliar. Untungnya 15% lebih, atau cuma 1,7% setahun.",
   "spoken": "Hari ini, modal satu miliar jadi hampir satu koma dua miliar. Untungnya lima belas persen lebih, atau cuma satu koma tujuh persen setahun."
  },
  {
   "id": "take-lesson-1",
   "scene": "lesson",
   "from": 2475,
   "dur": 241,
   "audio": "episodes/ep01-ihsg-dca/vo/take-lesson-1.mp3",
   "display": "DCA bikin kamu nggak pusing kapan beli, tapi hasilnya tergantung kapan kamu jual. Kalau kamu, tetap beli nggak waktu COVID? Tulis di komen!",
   "spoken": "DCA bikin kamu nggak pusing kapan beli, tapi hasilnya tergantung kapan kamu jual. Kalau kamu, tetap beli nggak waktu COVID? Tulis di komen!"
  },
  {
