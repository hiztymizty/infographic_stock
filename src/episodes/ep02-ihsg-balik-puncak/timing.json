 "voice": [
  {
   "id": "take-hook-1",
   "scene": "hook",
   "from": 10,
   "dur": 144,
   "audio": null,
   "display": "IHSG sempat turun 41%. Butuh naik berapa buat balik?",
   "spoken": "I-Ha-Es-Ge sempat turun empat puluh satu persen. Butuh naik berapa buat balik?"
  },
  {
   "id": "take-math-1",
   "scene": "math",
   "from": 178,
   "dur": 214,
   "audio": null,
   "display": "Modal Rp 100 turun jadi Rp 50. Buat balik, harus naik 100%, alias dobel. Nggak simetris, kan?",
   "spoken": "Modal seratus rupiah turun jadi lima puluh. Buat balik, harus naik seratus persen, alias dobel. Nggak simetris, kan?"
  },
  {
   "id": "take-math-2",
   "scene": "math",
   "from": 410,
   "dur": 166,
   "audio": null,
   "display": "Makanya IHSG yang turun 41%, butuh naik 71%.",
   "spoken": "Makanya I-Ha-Es-Ge yang turun empat puluh satu persen, butuh naik tujuh puluh satu persen."
  },
  {
   "id": "take-today-1",
   "scene": "today",
   "from": 605,
   "dur": 286,
   "audio": null,
   "display": "Sekarang IHSG udah naik 11% dari dasarnya. Tapi masih 35% di bawah puncak, dan butuh naik 54% lagi.",
   "spoken": "Sekarang I-Ha-Es-Ge udah naik sebelas persen dari dasarnya. Tapi masih tiga puluh lima persen di bawah puncak, dan butuh naik lima puluh empat persen lagi."
  },
  {
   "id": "take-history-1",
   "scene": "history",
   "from": 914,
   "dur": 477,
   "audio": null,
   "display": "Sejak 1997, IHSG tiga kali jatuh sedalam ini. Dari puncak sampai balik lagi, krismon butuh 6,5 tahun. Krisis 2008, 2,2 tahun. COVID, dari puncak 2018, 3,7 tahun.",
   "spoken": "Sejak sembilan belas sembilan puluh tujuh, I-Ha-Es-Ge tiga kali jatuh sedalam ini. Dari puncak sampai balik lagi, krismon butuh enam setengah tahun. Krisis dua ribu delapan, dua koma dua tahun. COVID, dari puncak dua ribu delapan belas, tiga koma tujuh tahun."
  },
  {
   "id": "take-lesson-1",
   "scene": "lesson",
   "from": 1426,
   "dur": 203,
   "audio": null,
   "display": "Tahun ini jatuhnya nggak sampai 5 bulan. Baliknya bisa bertahun-tahun, dan nggak ada yang bisa nebak kapan.",
   "spoken": "Tahun ini jatuhnya nggak sampai lima bulan. Baliknya bisa bertahun-tahun, dan nggak ada yang bisa nebak kapan."
  },
  {
   "id": "take-hakabot-outro-1",
   "scene": "hakabot-outro",
   "from": 1662,
   "dur": 159,
   "audio": null,
   "display": "Hakabot punya banyak indikator racikan sendiri, tinggal klik langsung muncul di chart.",
   "spoken": "Hakabot punya banyak indikator racikan sendiri, tinggal klik langsung muncul di chart."
  },
  {
   "id": "take-hakabot-outro-2",
