 "voice": [
  {
   "id": "take-hook-1",
   "scene": "hook",
   "from": 10,
   "dur": 154,
   "audio": "episodes/ep03-inflasi-tabungan/vo/take-hook-1.mp3",
   "display": "Rp 10 juta di lemari sejak 2010, sekarang bisa beli apa?",
   "spoken": "Sepuluh juta rupiah di lemari sejak dua ribu sepuluh, sekarang bisa beli apa?"
  },
  {
   "id": "take-shrink-1",
   "scene": "shrink",
   "from": 189,
   "dur": 409,
   "audio": "episodes/ep03-inflasi-tabungan/vo/take-shrink-1.mp3",
   "display": "Inflasi itu harga-harga yang naik pelan-pelan tiap tahun. Belanjaan yang dulu Rp 10 juta, sekarang harganya Rp 19 juta. Jadi uangmu tinggal setara Rp 5,3 juta zaman dulu, hampir setengahnya hilang.",
   "spoken": "Inflasi itu harga-harga yang naik pelan-pelan tiap tahun. Belanjaan yang dulu sepuluh juta, sekarang harganya sembilan belas juta. Jadi uangmu tinggal setara lima koma tiga juta zaman dulu, hampir setengahnya hilang."
  },
  {
   "id": "take-bank-1",
   "scene": "bank",
   "from": 632,
   "dur": 224,
   "audio": "episodes/ep03-inflasi-tabungan/vo/take-bank-1.mp3",
   "display": "Terus kalau ditabung di bank? Bunga tabungan dipotong pajak 20%, dan nggak pernah sekali pun ngalahin inflasi.",
   "spoken": "Terus kalau ditabung di bank? Bunga tabungan dipotong pajak dua puluh persen, dan nggak pernah sekali pun ngalahin inflasi."
  },
  {
   "id": "take-bank-2",
   "scene": "bank",
   "from": 875,
   "dur": 260,
   "audio": "episodes/ep03-inflasi-tabungan/vo/take-bank-2.mp3",
   "display": "Deposito lebih mending, tapi cuma menang tipis, sekitar 0,7% setahun. Itu pun pakai bunga deposito tertinggi yang dijamin.",
   "spoken": "Deposito lebih mending, tapi cuma menang tipis, sekitar nol koma tujuh persen setahun. Itu pun pakai bunga deposito tertinggi yang dijamin."
  },
  {
   "id": "take-formula-1",
   "scene": "formula",
   "from": 1169,
   "dur": 188,
   "audio": "episodes/ep03-inflasi-tabungan/vo/take-formula-1.mp3",
   "display": "Jadi inget rumus ini, hasil bersih setelah pajak dan biaya dikurangi inflasi, itulah untung beneran.",
   "spoken": "Jadi inget rumus ini, hasil bersih setelah pajak dan biaya dikurangi inflasi, itulah untung beneran."
  },
  {
   "id": "take-formula-2",
   "scene": "formula",
   "from": 1375,
   "dur": 447,
   "audio": "episodes/ep03-inflasi-tabungan/vo/take-formula-2.mp3",
   "display": "Deposito hari ini 3,75%, setelah pajak tinggal 3%. Inflasinya 3,28%, jadi malah minus 0,28%. Saldonya kelihatan nambah, padahal nilainya sebenarnya turun.",
   "spoken": "Deposito hari ini tiga koma tujuh lima persen, setelah pajak tinggal tiga persen. Inflasinya tiga koma dua delapan persen, jadi malah minus nol koma dua delapan persen. Saldonya kelihatan nambah, padahal nilainya sebenarnya turun."
  },
  {
   "id": "take-lesson-1",
   "scene": "lesson",
   "from": 1863,
   "dur": 294,
   "audio": "episodes/ep03-inflasi-tabungan/vo/take-lesson-1.mp3",
   "display": "Sebelum naruh uang, cek dulu inflasi terbaru dari BPS, Badan Pusat Statistik. Hasil bersihnya harus di atas itu, baru uangmu beneran tumbuh.",
   "spoken": "Sebelum naruh uang, cek dulu inflasi terbaru dari Be-Pe-Es, Badan Pusat Statistik. Hasil bersihnya harus di atas itu, baru uangmu beneran tumbuh."
  },
